{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cool-careers",
      "destination": "/cool-careers/index.html"
    },
    {
      "source": "/edutainment",
      "destination": "/edutainment/index.html"
    },
    {
      "source": "/regenerative-art",
      "destination": "/regenerative-art/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cool-careers/trophic-cascades",
      "destination": "https://cool-careers.allaboardearth.com/s/explore?card=soil-microbiologist",
      "permanent": true
    },
    {
      "source": "/coolcareers/:slug",
      "destination": "https://cool-careers.allaboardearth.com/s/explore?card=:slug",
      "permanent": true
    },
    {
      "source": "/coolactions/:slug",
      "destination": "https://cool-careers.allaboardearth.com/s/explore?card=:slug",
      "permanent": true
    },
    {
      "source": "/coolcareers",
      "destination": "https://cool-careers.allaboardearth.com/s/explore",
      "permanent": true
    },
    {
      "source": "/coolactions",
      "destination": "https://cool-careers.allaboardearth.com/s/explore",
      "permanent": true
    },
    {
      "source": "/cool-careers/game",
      "destination": "https://cool-careers.allaboardearth.com",
      "permanent": true
    },
    {
      "source": "/grooves",
      "destination": "https://open.spotify.com/artist/3PxV0vuP14pMfk7HJi1YFE",
      "permanent": true
    },
    {
      "source": "/art",
      "destination": "/regenerative-art",
      "permanent": true
    },
    {
      "source": "/community-theater",
      "destination": "/edutainment",
      "permanent": true
    },
    {
      "source": "/eco-film-camp",
      "destination": "/edutainment",
      "permanent": true
    },
    {
      "source": "/copy-of-eco-arts-activism",
      "destination": "/regenerative-art",
      "permanent": true
    },
    {
      "source": "/curriculum",
      "destination": "/cool-careers",
      "permanent": true
    },
    {
      "source": "/mentorship",
      "destination": "/cool-careers",
      "permanent": true
    },
    {
      "source": "/solar",
      "destination": "/cool-careers",
      "permanent": true
    },
    {
      "source": "/book-online",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/service-page/:slug*",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/booking-calendar/:slug*",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about-5",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/michael-meade",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/compost-cafe",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projects-7",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/copy-of-programs-events",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/book-a-demo",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "new.allaboardearth.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
